    <!-- 字体大小控制 -->
    <div class="font-control">
        <button onclick="adjustFont('smaller')">字体缩小</button>
        <button onclick="adjustFont('bigger')">字体放大</button>
    </div>

    <script>
        function switchStyle(styleName) {
            const themeLink = document.getElementById('theme-style');
            themeLink.href = `../css/${styleName}.css`;
        }

        function adjustFont(type) {
            const body = document.body;
            const currentSize = parseFloat(getComputedStyle(body).fontSize);
            body.style.fontSize = type === 'bigger' ? (currentSize + 1) + 'px' : (currentSize - 1) + 'px';
        }
    </script>
